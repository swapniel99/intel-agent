{
  "manifest_version": 3,
  "name": "AgentCurator: MCP Assistant",
  "version": "1.0",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.googleapis.com/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open AgentCurator"
  }
}
